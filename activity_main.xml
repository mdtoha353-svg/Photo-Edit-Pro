<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#101114">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PhotoEditPro" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="360dp" android:background="#202228">
            <ImageView android:id="@+id/imageView" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone"/>
            <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="একটি ছবি নির্বাচন করুন" android:textColor="#AAAAAA" android:textSize="18sp"/>
        </FrameLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/openButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ছবি নির্বাচন করুন" android:layout_marginTop="14dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Brightness" android:textColor="#FFFFFF" android:layout_marginTop="12dp"/>
        <com.google.android.material.slider.Slider android:id="@+id/brightnessSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="-1" android:valueTo="1" android:value="0" android:stepSize="0.01"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contrast" android:textColor="#FFFFFF"/>
        <com.google.android.material.slider.Slider android:id="@+id/contrastSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0.5" android:valueTo="1.8" android:value="1" android:stepSize="0.01"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saturation" android:textColor="#FFFFFF"/>
        <com.google.android.material.slider.Slider android:id="@+id/saturationSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="2" android:value="1" android:stepSize="0.01"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/rotateButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Rotate"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Save"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
